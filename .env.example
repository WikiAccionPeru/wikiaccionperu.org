# Wikimedia OAuth 2.0 client (https://api.wikimedia.org/wiki/Special:OAuthConsumerRegistration — "OAuth 2.0", not "owner-only")
# Callback URL to register:  <NUXT_PUBLIC_SITE_URL>/api/auth/callback
NUXT_OAUTH_CLIENT_ID=
NUXT_OAUTH_CLIENT_SECRET=
# Random string, 32+ characters (e.g. `openssl rand -base64 48`)
NUXT_SESSION_SECRET=
# Public base URL of this site (no trailing slash)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reusing an existing consumer instead (e.g. Lingua Libre, localhost only) ---
# CLIENT_ID / CLIENT_SECRET (and VITE_AUTHORIZATION_ENDPOINT) are read as fallbacks, same names as Lingua Libre's config.
# That consumer's callback is fixed to http://localhost:8079/oauth/wikimedia/success -> run `npm run dev:oauth`.
# Confidential consumers also need NUXT_OAUTH_CLIENT_SECRET.
